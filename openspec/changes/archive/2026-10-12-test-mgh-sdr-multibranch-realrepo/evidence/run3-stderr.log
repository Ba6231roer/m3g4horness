options:
  -h, --help            show this help message and exit
  --repo REPO           absolute target git repo root
  --branch BRANCH       branch ref (default: current branch)
  --base BASE           base ref (default master)
  --host {opencode,claude}
                        host CLI (default: opencode in PATH, else claude)
  --dimensions <inline-json>
